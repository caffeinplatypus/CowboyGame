ui.innerHTML=`<div class=pn><h1>DUST &amp; BULLETS</h1>${extra}<p>Gold: <b>${S.gold}</b></p><h3>OUTFITS</h3><div class=row>${SK.map((s,i)=>card(s,i,'skins','skin')).join('')}</div><h3>WEAPON</h3><div class=row>${WP.map((s,i)=>card(s,i,'weps','wep')).join('')}</div><h3>TERRITORIES</h3><div class=row>${MP.map((s,i)=>card(s,i,'maps','map')).join('')}</div><button class=go style="background:#e8d3a3;color:#3a2512;margin-right:8px" onclick="saloon('skins')">SALOON</button><button class=go onclick="start()">RIDE OUT</button><p class=sm>Left stick / WASD: move · Right stick / arrow keys: aim and fire · BURST button / Space: shotgun blast, 90s cooldown · clear a wave, ride through the gate, pick a perk</p></div>`}
const GBu=new T.SphereGeometry(.16,6,4),GGe=new T.OctahedronGeometry(.25);
let rr=null;
function saloon(tab,msg=''){tab=tab=='weps'?'weps':'skins';mode='menu';ui.style.display='flex';rr=null;const L=tab=='skins'?SK:WP,sel=tab=='skins'?'skin':'wep';
const rows=L.map((s,i)=>{const own=S[tab].includes(i),w=Math.ceil(s.cost/2),dot=s.h?`linear-gradient(135deg,${s.c} 50%,${s.h} 50%)`:s.sw;
return `<div class=it><i style="background:${dot}"></i><b>${s.n}</b><small>${s.d||''}</small><span>${own?(S[sel]==i?'Equipped':`<button class=cd onclick="eq('${tab}','${sel}',${i})">Equip</button>`):`<button class=cd onclick="buy('${tab}',${i})">Buy ${s.cost}g</button>${tab=='skins'?`<button class=cd onclick="roul(${i})">Gamble ${w}g</button>`:''}`}</span></div>`}).join('');
ui.innerHTML=`<div class=pn><h1>THE SALOON</h1><p>Gold: <b>${S.gold}</b> ${msg}</p><div class=row><button class="cd ${tab=='skins'?'on':''}" onclick="saloon('skins')">Outfits</button><button class="cd ${tab=='weps'?'on':''}" onclick="saloon('weps')">Weapons</button></div><div class=lst>${rows}</div><button class=go onclick="menu()">BACK TO THE TRAIL</button></div>`}
function eq(k,sel,i){S[sel]=i;save();if(k=='skins')setDm();saloon(k)}
function buy(k,i){const L=k=='skins'?SK:WP;if(S.gold<L[i].cost){saloon(k,'· not enough gold');return}S.gold-=L[i].cost;S[k].push(i);S[k=='skins'?'skin':'wep']=i;save();if(k=='skins')setDm();saloon(k,'· bought '+L[i].n)}
function roul(i){const s=SK[i],w=Math.ceil(s.cost/2);if(!rr||rr.i!==i)rr={i,w,paid:0,b:0,n:0,res:[],done:0};
const ch=[0,1,2,3,4,5].map(k=>{const r=rr.res[k];return `<i class="ch ${r==1?'em':r==2?'bn':rr.done&&k==rr.b?'bn dim':''}">${r==1?'✓':r==2?'💥':''}</i>`}).join('');let t,b='';
if(!rr.paid){t=`Wager <b>${w}</b> gold. Pull the trigger 3 times on a 6-chamber revolver with one loaded chamber, firing at the bottle on the bar. Survive and the <b>${s.n}</b> outfit is yours and your wager comes back. Hit the loaded chamber and the house keeps your gold.`;b=`<button class=go ${S.gold<w?'disabled':''} onclick="rpay()">PAY ${w}g &amp; SPIN</button>`}
else if(!rr.done){t=`${rr.n} of 3 pulls survived so far.`;b=`<button class=go onclick="rpull()">PULL THE TRIGGER</button>`}
else if(rr.done==1){t=`Click, click, click! The ${s.n} outfit is yours, and your ${w} gold comes back.`}
else{t=`BANG! The bottle shatters. The house keeps your ${w} gold.`;b=`<button class=go onclick="rr=null;roul(${i})">TRY AGAIN</button>`}
ui.innerHTML=`<div class=pn><h1>ROULETTE</h1><p>Gold: <b>${S.gold}</b></p><div>${ch}</div><p style="max-width:420px;margin:8px auto">${t}</p>${b}<br>${!rr.paid||rr.done?`<button class=go style="background:#e8d3a3;color:#3a2512" onclick="saloon('skins')">BACK TO THE BAR</button>`:''}</div>`}
function rpay(){if(S.gold<rr.w)return;S.gold-=rr.w;rr.paid=1;rr.b=Math.random()*6|0;rr.n=0;save();roul(rr.i)}
function rpull(){if(rr.done)return;const k=rr.n;if(k==rr.b){rr.res[k]=2;rr.done=2}else{rr.res[k]=1;rr.n++;if(rr.n>=3){rr.done=1;S.gold+=rr.w;S.skins.push(rr.i);S.skin=rr.i;setDm()}}save();roul(rr.i)}
function start(){if(g)sc.remove(g.grp);const grp=new T.Group();sc.add(grp);dm.visible=false;
g={grp,t:0,kills:0,sp:0,hit:0,wave:0,left:0,cl:0,rest:3,bt:0,gold:0,tot:0,gate:null,nx:0,want:0,fa:0,e:[],b:[],gm:[],p:{x:0,z:0,hp:100,max:100,spd:7,dmg:10,rate:2,cd:0,bt:0,bcd:1,bdm:1,bang:1,multi:1,pierce:0,mag:2.5,xp:0,lv:1,nx:5,inv:0},pm:pl(1)};
grp.add(g.pm);{const w=WP[S.wep],q=g.p;q.dmg*=w.dmg;q.rate*=w.rate;q.multi=w.multi;q.pierce=w.pierce;q.sprd=w.sprd;q.bsp=w.sp;q.bl=w.l;q.jit=w.jit||0}joy.x=joy.z=0;aim.x=aim.z=0;jt=null;ban('GET READY');mode='play';ui.style.display='none';hud.style.display='block';cc(1);last=performance.now()}
function lvl(){mode='lvl';opts=[...UP].sort(()=>Math.random()-.5).slice(0,3);ui.style.display='flex';
ui.innerHTML=`<div class=pn><h1>WAVE ${g.wave} SURVIVED</h1><p class=sm>Pick a perk before you ride on</p>${opts.map((u,i)=>`<button class=up onclick="take(${i})"><b>${i+1}. ${u.n}</b><br>${u.d}</button>`).join('')}</div>`}
function take(i){opts[i].f(g.p);mode='play';ui.style.display='none';last=performance.now();if(g.nx){g.nx=0;nextWave()}}
function die(){const gold=g.wave*5+Math.floor(g.gold/2);S.gold+=gold;save();sc.remove(g.grp);const w=g.wave,k=g.kills;g=null;build();bnr.style.opacity=0;joy.x=joy.z=0;jt=null;
menu(`<p>You’re done, partner. Made it to wave <b>${w}</b>, <b>${k}</b> outlaws down.<br>+${gold} gold</p>`)}
function gate(){const G=new T.Group(),w=mat(0x4a2f17),nv=MP[S.map].v[g.wave%3],a=(ge,m,x,y)=>{const o=new T.Mesh(ge,m);o.position.set(x,y,0);G.add(o)};
a(gb(.5,3.6,.5),w,-2.3,1.8);a(gb(.5,3.6,.5),w,2.3,1.8);a(gb(5.6,.5,.5),w,0,3.7);a(gb(3,.5,.15),mat(0xe8d3a3),0,4.3);
const pt=new T.Mesh(new T.PlaneGeometry(4.1,3.4),new T.MeshBasicMaterial({color:nv.s,transparent:true,opacity:.8}));pt.position.set(0,1.7,0);G.add(pt);
const ar=new T.Mesh(new T.ConeGeometry(.5,1,4),new T.MeshBasicMaterial({color:0xffc933}));ar.rotation.x=Math.PI;ar.position.set(0,5.4,0);G.add(ar);
G.userData.ar=ar;G.position.set(0,0,-16);return G}
function nextWave(){g.wave++;g.left=g.tot=6+g.wave*4;g.sp=0;g.p.x=0;g.p.z=13;build();ban('WAVE '+g.wave+' · '+MP[S.map].v[(g.wave-1)%3].n.toUpperCase())}
const ET=[[.6,20,2.6,8,'#6b2e25',1,'#1a1410',{pants:'#4a3a2a',mask:'#8a1c1c'}],[.5,12,4.5,6,'#7a6a2a',.85,'#5a3a1a',{pants:'#2a2a2a',mask:'#222',lean:1}],[.9,70,1.8,15,'#2a2a2a',1.5,'#0f0b08',{pants:'#1a1a1a',mask:'#555',pad:1}]];
function spawn(){const r=Math.random(),i=(r<.6||g.wave<2)?0:(r<.85||g.wave<4)?1:2,E=ET[i],s=1+g.wave*.15,a=Math.random();
const [x,z]=[[(a-.5)*48,-18],[(a-.5)*48,18],[-25,(a-.5)*34],[25,(a-.5)*34]][Math.random()*4|0];
const m=cowboy(E[4],E[6],E[5],E[7]);m.position.set(x,0,z);g.grp.add(m);g.e.push({m,x,z,r:E[0],hp:E[1]*s,s:E[2],d:E[3]})}
function upd(dt){const p=g.p;g.t+=dt;g.hit=Math.max(0,g.hit-dt*2);
const dx=joy.x||((keys.d?1:0)-(keys.a?1:0)),dz=joy.z||((keys.s?1:0)-(keys.w?1:0)),ax=aim.x||((keys.ArrowRight?1:0)-(keys.ArrowLeft?1:0)),az=aim.z||((keys.ArrowDown?1:0)-(keys.ArrowUp?1:0)),aiming=Math.hypot(ax,az)>.25,mv=Math.max(1,Math.hypot(dx,dz));
p.x=cl(p.x+dx/mv*p.spd*dt,-22,22);p.z=cl(p.z+dz/mv*p.spd*dt,-15,15);p.inv-=dt;p.bt=Math.max(0,p.bt-dt);
g.pm.position.set(p.x,0,p.z);anim(g.pm,dt,Math.min(1,Math.hypot(dx,dz)),14);
g.pm.visible=!(p.inv>0&&(g.t*20|0)%2);
if(g.left>0){g.sp-=dt;if(g.sp<=0){g.sp=Math.max(.2,.9-g.wave*.05);g.left--;spawn()}}
else if(!g.e.length){
if(!g.wave){g.rest-=dt;if(g.rest<=0)nextWave()}
else if(!g.gate){g.gate=gate();g.grp.add(g.gate);ban('WAVE '+g.wave+' CLEARED · RIDE THROUGH THE GATE');p.hp=Math.min(p.max,p.hp+15)}
else{g.gate.userData.ar.position.y=5.4+Math.sin(g.t*5)*.3;if(p.z<-13&&Math.abs(p.x)<2.8){g.grp.remove(g.gate);g.gate=null;g.nx=1;lvl();return}}}
g.bt-=dt;bnr.style.opacity=Math.max(0,Math.min(1,g.bt));
g.want=aiming?Math.atan2(ax,az):(dx||dz)?Math.atan2(dx,dz):g.want;
g.fa+=Math.atan2(Math.sin(g.want-g.fa),Math.cos(g.want-g.fa))*Math.min(1,dt*14);g.pm.rotation.y=g.fa;
p.cd-=dt;if(p.cd<=0&&aiming){const a=Math.atan2(az,ax);
for(let i=0;i<p.multi;i++){const o=a+(i-(p.multi-1)/2)*p.sprd+(Math.random()-.5)*p.jit,m=new T.Mesh(GBu,mat('#ffe08a'));m.position.set(p.x,1.2,p.z);g.grp.add(m);
g.b.push({m,x:p.x,z:p.z,vx:Math.cos(o)*p.bsp,vz:Math.sin(o)*p.bsp,pr:p.pierce,l:p.bl,h:new Set(),dm:p.dmg})}p.cd=1/p.rate}
for(const b of g.b){b.x+=b.vx*dt;b.z+=b.vz*dt;b.l-=dt;b.m.position.set(b.x,1.2,b.z);
for(const e of g.e){if(b.h.has(e)||Math.hypot(e.x-b.x,e.z-b.z)>e.r+.3)continue;e.hp-=b.dm;b.h.add(e);if(--b.pr<0){b.l=0;break}}}
for(const e of g.e){const a=Math.atan2(p.z-e.z,p.x-e.x);e.x+=Math.cos(a)*e.s*dt;e.z+=Math.sin(a)*e.s*dt;
e.m.position.set(e.x,0,e.z);anim(e.m,dt,1,4+e.s*2);e.m.rotation.y=Math.atan2(p.x-e.x,p.z-e.z);
if(p.inv<=0&&Math.hypot(p.x-e.x,p.z-e.z)<e.r+.6){p.hp-=e.d;p.inv=.6;g.hit=1}
if(e.hp<=0){g.kills++;g.grp.remove(e.m);const m=new T.Mesh(GGe,mat('#ffc933'));m.position.set(e.x,.4,e.z);g.grp.add(m);g.gm.push({m,x:e.x,z:e.z})}}
g.e=g.e.filter(e=>e.hp>0);for(const b of g.b)if(b.l<=0)g.grp.remove(b.m);g.b=g.b.filter(b=>b.l>0);
for(const m of g.gm){const d=Math.hypot(p.x-m.x,p.z-m.z);if(d<p.mag||g.gate){m.x+=(p.x-m.x)/d*10*dt;m.z+=(p.z-m.z)/d*10*dt}m.m.position.set(m.x,.4+Math.sin(g.t*4+m.x)*.08,m.z);m.m.rotation.y+=dt*3;
if(d<.7){m.o=1;g.grp.remove(m.m);g.gold++}}
g.gm=g.gm.filter(m=>!m.o);
if(p.hp<=0)return die();

document.getElementById('hp').style.width=Math.max(0,p.hp/p.max*100)+'%';document.getElementById('xp').style.width=(g.tot?(1-(g.left+g.e.length)/g.tot)*100:0)+'%';bb.textContent=p.bt>0?Math.ceil(p.bt)+'s':'BURST';bb.classList.toggle('cd',p.bt>0);
document.getElementById('ht').textContent=`Wave ${g.wave} · ${g.gold} gold · ${g.kills} outlaws down`}
const nc=document.getElementById('n'),nx=nc.getContext('2d'),nd=nx.createImageData(128,80);let fr=0;
function noise(){for(let i=0;i<nd.data.length;i+=4){nd.data[i]=nd.data[i+1]=nd.data[i+2]=Math.random()*255;nd.data[i+3]=255}nx.putImageData(nd,0,0)}
function loop(n){const dt=Math.min(.05,(n-last)/1000);last=n;T0+=dt;
if(g&&mode=='play')upd(dt);
if(g){const p=g.p,sh=g.hit*.4;cam.position.x+=(p.x*.8-cam.position.x)*Math.min(1,dt*5);cam.position.z+=(p.z*.8+21-cam.position.z)*Math.min(1,dt*5);
cam.position.y=7.5+(Math.random()-.5)*sh;cam.lookAt(p.x*.8+(Math.random()-.5)*sh,0,p.z*.8-1)}
else{cam.position.set(Math.sin(T0*.3)*10,2.8,Math.cos(T0*.3)*10);cam.lookAt(0,-.4,0);if(dm){dm.rotation.y=T0*.5;anim(dm,dt,.6,12)}}
if(cld)cld.rotation.y=T0*.01;R.render(sc,cam);
if(fr++%2==0)noise();nc.style.opacity=.13+(g?g.hit*.6:.12)+Math.random()*.04;
requestAnimationFrame(loop)}
addEventListener('keydown',e=>{const k=e.key.length==1?e.key.toLowerCase():e.key;keys[k]=1;
if(k.startsWith('Arrow')||k==' ')e.preventDefault();if(k==' '||k=='e')burst();if(mode=='lvl'&&'123'.includes(k)&&opts[k-1])take(k-1)});
addEventListener('keyup',e=>{keys[e.key.length==1?e.key.toLowerCase():e.key]=0});
const bnr=document.getElementById('bn');function ban(t){bnr.textContent=t;g.bt=2.5}
const joy={x:0,z:0},aim={x:0,z:0},bb=document.getElementById('bb');let jt=null;
const SKS=[{el:document.getElementById('jl'),v:joy,id:null},{el:document.getElementById('jr'),v:aim,id:null}];
function cc(on){for(const k of SKS)k.el.style.display=on?'block':'none';bb.style.display=on?'block':'none'}
function sk(k,t,start){const r=k.el.getBoundingClientRect();let x=t.clientX-r.left-r.width/2,y=t.clientY-r.top-r.height/2;
if(start&&Math.hypot(x,y)>r.width*.85)return false;
const d=Math.hypot(x,y)||1,m=Math.min(1,d/45);x=x/d*m;y=y/d*m;k.v.x=x;k.v.z=y;k.el.firstChild.style.transform=`translate(${x*38}px,${y*38}px)`;return true}
function rel(k){k.id=null;k.v.x=k.v.z=0;k.el.firstChild.style.transform=''}
wr.addEventListener('touchstart',e=>{if(mode!='play')return;for(const t of e.changedTouches)for(const k of SKS)if(k.id===null&&sk(k,t,1)){k.id=t.identifier;e.preventDefault();break}},{passive:false});
wr.addEventListener('touchmove',e=>{if(mode!='play')return;for(const t of e.changedTouches)for(const k of SKS)if(k.id===t.identifier)sk(k,t,0);e.preventDefault()},{passive:false});
const te=e=>{for(const t of e.changedTouches)for(const k of SKS)if(k.id===t.identifier)rel(k)};
wr.addEventListener('touchend',te);wr.addEventListener('touchcancel',te);
bb.addEventListener('touchstart',e=>{e.preventDefault();e.stopPropagation();burst()},{passive:false});bb.addEventListener('click',burst);
function burst(){if(!g||mode!='play')return;const p=g.p;if(p.bt>0)return;p.bt=90*p.bcd;g.hit=Math.max(g.hit,.5);
const base=Math.PI/2-g.want,ang=Math.PI/4*p.bang;
for(let i=0;i<20;i++){const o=base+(i/19-.5)*ang+(Math.random()-.5)*.04,v=22+Math.random()*5,m=new T.Mesh(GBu,mat('#ffb347'));m.scale.setScalar(1.3);m.position.set(p.x,1.2,p.z);g.grp.add(m);
g.b.push({m,x:p.x,z:p.z,vx:Math.cos(o)*v,vz:Math.sin(o)*v,pr:1,l:.5*p.bang,h:new Set(),dm:p.dmg/WP[S.wep].dmg*2.5*p.bdm})}}
build();menu();requestAnimationFrame(loop);
</script></body></html>
